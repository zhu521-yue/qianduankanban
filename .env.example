# 全项目统一运行配置。复制为项目根目录 .env 后按实际环境修改。
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql://root:change-me@127.0.0.1:5432/weidian
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_NAME=ai_dashboard_session
SESSION_TTL_HOURS=8
ACCOUNTS_FILE=config/accounts.json
MAX_UPLOAD_BYTES=314572800
# 生成方式：cd 8.11/backend; python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_NAME=
# 四个固定登录角色各自独立的AI接口配置，由设置页测试通过后写入。
AI_MANAGER_BASE_URL=
AI_MANAGER_API_KEY=
AI_MANAGER_MODEL_NAME=
AI_TALENT_BASE_URL=
AI_TALENT_API_KEY=
AI_TALENT_MODEL_NAME=
AI_PRIVATE_BASE_URL=
AI_PRIVATE_API_KEY=
AI_PRIVATE_MODEL_NAME=
AI_DISTRIBUTION_BASE_URL=
AI_DISTRIBUTION_API_KEY=
AI_DISTRIBUTION_MODEL_NAME=
AI_DEFAULT_MODEL=default
AI_REQUEST_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.2
# 本地开发留空 BASE_URL，让 API 主机名自动跟随浏览器地址栏，避免登录 Cookie 跨站。
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_PORT=8000
